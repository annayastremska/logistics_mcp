# Secrets and local configuration
.env
.env.local
*.local.json

# Runtime cache of live API responses (fixtures under fixtures/ are committed)
.cache/

# Agent tooling configuration. Kept out of the repo because agent folders can
# hold credentials or machine-specific state; the spec-kit templates under
# .specify/ are committed instead.
.claude/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
scripts/last_e2e_trace.jsonl

# Playwright MCP session artefacts: console logs and page snapshots
# written per run. Transient by nature; nothing here is worth keeping.
.playwright-mcp/
scripts/last_failure_demo_trace.jsonl
