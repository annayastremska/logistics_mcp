# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---------------------------------------------------------------------------
# Model credentials for the agent (Claude Agent SDK)
# ---------------------------------------------------------------------------
# The Agent SDK resolves credentials in this order:
#   1. ANTHROPIC_API_KEY below, if set
#   2. otherwise the local Claude Code login (`claude` -> /login)
# Only one is needed. The custom MCP server itself needs no credentials at all.
ANTHROPIC_API_KEY=

# Model the agent runs on.
SOURCING_AGENT_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Data transport mode for the custom MCP server
# ---------------------------------------------------------------------------
# live    - call the open APIs (default)
# record  - call them and write every response to fixtures/
# replay  - serve from fixtures/, no network access
SOURCING_MODE=live

# Hours to keep the local response cache. Does not affect fixtures.
SOURCING_CACHE_TTL=86400
